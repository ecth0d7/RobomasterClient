# Optional asset conditioning; preserve GLB sources and every older cache directory.
if(NOT EXISTS "${SOURCE}" OR NOT EXISTS "${BALSAM}" OR NOT EXISTS "${CATALOG}")
    return()
endif()
file(SHA256 "${SOURCE}" _current_hash)
if(NOT _current_hash STREQUAL SOURCE_HASH)
    message(WARNING "3D source changed since configuration; keeping GLB fallback until reconfigure")
    return()
endif()
file(MAKE_DIRECTORY "${BUNDLE}")
set(_manifest_path "${BUNDLE}/prepared-manifest.json")
set(_valid FALSE)
if(EXISTS "${_manifest_path}")
    file(READ "${_manifest_path}" _manifest)
    string(JSON _count ERROR_VARIABLE _error LENGTH "${_manifest}" files)
    string(JSON _cached_component ERROR_VARIABLE _component_error GET "${_manifest}" component)
    if(NOT _error AND NOT _component_error AND _count GREATER 1 AND _count LESS_EQUAL 256)
        set(_valid TRUE)
        math(EXPR _last "${_count}-1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _relative ERROR_VARIABLE _file_error GET "${_manifest}" files ${_index} file)
            string(JSON _expected ERROR_VARIABLE _size_error GET "${_manifest}" files ${_index} size)
            if(_file_error OR _size_error OR NOT _expected MATCHES "^[1-9][0-9]*$"
                    OR NOT EXISTS "${BUNDLE}/${_relative}")
                set(_valid FALSE)
            else()
                file(SIZE "${BUNDLE}/${_relative}" _size)
                if(NOT _size EQUAL _expected)
                    set(_valid FALSE)
                endif()
            endif()
        endforeach()
    endif()
endif()
if(NOT _valid)
    execute_process(COMMAND "${BALSAM}" --outputPath "${BUNDLE}"
        --disable-findDegenerates --disable-findInvalidData --disable-removeComponentUVs
        --disable-removeComponentColors --disable-removeRedundantMaterials "${SOURCE}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 180)
    file(WRITE "${BUNDLE}/conversion.log" "${_stdout}\n${_stderr}")
    if(NOT "${_result}" STREQUAL "0")
        message(WARNING "Optional 3D conditioning failed; GLB remains available (${_result})")
        return()
    endif()
    file(GLOB _components "${BUNDLE}/*.qml")
    list(LENGTH _components _component_count)
    if(NOT _component_count EQUAL 1)
        message(WARNING "Unexpected conditioned field component count; keeping GLB fallback")
        return()
    endif()
    list(GET _components 0 _component)
    file(READ "${_component}" _qml)
    string(REGEX MATCHALL "\"(meshes|maps)/[^\"]+\"" _references "${_qml}")
    foreach(_reference IN LISTS _references)
        string(REGEX REPLACE "^\"|\"$" "" _relative "${_reference}")
        if(NOT EXISTS "${BUNDLE}/${_relative}")
            message(WARNING "Conditioned field has an incomplete resource; keeping GLB fallback")
            return()
        endif()
    endforeach()
    file(GLOB_RECURSE _files RELATIVE "${BUNDLE}" "${BUNDLE}/*.qml" "${BUNDLE}/*.mesh"
        "${BUNDLE}/*.png" "${BUNDLE}/*.jpg" "${BUNDLE}/*.jpeg" "${BUNDLE}/*.ktx")
    list(LENGTH _files _count)
    if(_count LESS 2 OR _count GREATER 256)
        message(WARNING "Unexpected conditioned field resource count; keeping GLB fallback")
        return()
    endif()
    set(_manifest "{\"files\":[]}")
    set(_index 0)
    foreach(_relative IN LISTS _files)
        file(SIZE "${BUNDLE}/${_relative}" _size)
        if(_size LESS 1)
            message(WARNING "Empty conditioned field resource; keeping GLB fallback")
            return()
        endif()
        string(JSON _manifest SET "${_manifest}" files ${_index} "{\"file\":\"${_relative}\",\"size\":${_size}}")
        math(EXPR _index "${_index}+1")
    endforeach()
    get_filename_component(_name "${_component}" NAME)
    string(JSON _manifest SET "${_manifest}" component "\"${_name}\"")
    file(WRITE "${_manifest_path}" "${_manifest}\n")
endif()
# Qt's mesh ABI is not a portable interchange format. Publish the exact SDK version.
string(JSON _component GET "${_manifest}" component)
get_filename_component(_catalog_dir "${CATALOG}" DIRECTORY)
file(RELATIVE_PATH _relative_bundle "${_catalog_dir}" "${BUNDLE}")
set(_entries "")
math(EXPR _last "${_count}-1")
foreach(_index RANGE 0 ${_last})
    string(JSON _relative GET "${_manifest}" files ${_index} file)
    string(JSON _size GET "${_manifest}" files ${_index} size)
    list(APPEND _entries "{url: String(Qt.resolvedUrl(\"${_relative_bundle}/${_relative}\")), size: ${_size}}")
endforeach()
list(JOIN _entries ",\n        " _entries_text)
file(WRITE "${CATALOG}" "import QtQml\n\n// Generated for this Qt SDK; do not copy across runtime versions.\nQtObject {\n    readonly property string qtVersion: \"${QT_VERSION}\"\n    readonly property url source: Qt.resolvedUrl(\"${_relative_bundle}/${_component}\")\n    readonly property var files: [\n        ${_entries_text}\n    ]\n}\n")

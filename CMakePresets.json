{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF",
        "ROBOMASTER_BUILD_DEVELOPER_TOOLS": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "supported-release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/supported-release",
      "description": "Compatibility release preset; discover installed dependencies without machine-specific paths"
    },
    {
      "name": "validation",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/validation",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ROBOMASTER_BUILD_DEVELOPER_TOOLS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "supported-release",
      "configurePreset": "supported-release",
      "jobs": 4
    },
    {
      "name": "validation",
      "configurePreset": "validation",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "validation",
      "configurePreset": "validation",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

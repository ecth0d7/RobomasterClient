include_guard(GLOBAL)

# Authoring convenience only. Runtime import still validates the complete
# manifest, configuration schema, Qt metadata and bounded installed artifact.
function(_rmext_json_string output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_rmext_bracket_quote output value)
    set(equals "=")
    string(FIND "${value}" "]${equals}]" found)
    while(NOT found EQUAL -1)
        string(APPEND equals "=")
        string(FIND "${value}" "]${equals}]" found)
    endwhile()
    set(${output} "[${equals}[${value}]${equals}]" PARENT_SCOPE)
endfunction()

function(_rmext_validate_files source_root files native absolute_files)
    list(LENGTH files count)
    set(limit 255)
    if(native)
        set(limit 254)
    endif()
    if(count LESS 1 OR count GREATER limit)
        message(FATAL_ERROR "Extension FILES must list1..${limit} explicit runtime files")
    endif()
    set(seen)
    set(directory_names)
    set(directory_spellings)
    set(absolute)
    set(total 0)
    foreach(relative IN LISTS files)
        if(IS_ABSOLUTE "${relative}" OR relative STREQUAL "" OR
           relative MATCHES "(^|/)\\.\\.?(/|$)|//|/$")
            message(FATAL_ERROR "Extension FILES contains an absolute/traversing/ambiguous path: ${relative}")
        endif()
        foreach(forbidden IN ITEMS "\\" ":" ";" "$" "<" ">" "\n" "\r" "\t")
            string(FIND "${relative}" "${forbidden}" found)
            if(NOT found EQUAL -1)
                message(FATAL_ERROR "Extension FILES contains a nonportable or generated path: ${relative}")
            endif()
        endforeach()
        string(TOLOWER "${relative}" folded)
        if(folded IN_LIST seen)
            message(FATAL_ERROR "Extension FILES has a duplicate/case-colliding path: ${relative}")
        endif()
        string(REPLACE "/" ";" components "${relative}")
        list(LENGTH components depth)
        if(depth GREATER 9)
            message(FATAL_ERROR "Extension FILES exceeds8 directory levels: ${relative}")
        endif()
        set(prefix "")
        foreach(component IN LISTS components)
            string(TOLOWER "${component}" lower_component)
            if(lower_component STREQUAL "native" OR lower_component STREQUAL "rmplugin.json" OR
               lower_component STREQUAL "node_modules" OR lower_component STREQUAL "build" OR
               lower_component STREQUAL "rmplugin-packages" OR lower_component MATCHES "^\\.")
                message(FATAL_ERROR "Extension FILES uses a reserved package path: ${relative}")
            endif()
            if(prefix STREQUAL "")
                set(prefix "${component}")
            else()
                string(APPEND prefix "/${component}")
            endif()
            if(IS_SYMLINK "${source_root}/${prefix}")
                message(FATAL_ERROR "Extension FILES cannot traverse a source symlink: ${relative}")
            endif()
            if(NOT prefix STREQUAL relative)
                string(TOLOWER "${prefix}" lower_prefix)
                list(FIND directory_names "${lower_prefix}" directory_index)
                if(directory_index EQUAL -1)
                    list(APPEND directory_names "${lower_prefix}")
                    list(APPEND directory_spellings "${prefix}")
                else()
                    list(GET directory_spellings ${directory_index} original_prefix)
                    if(NOT original_prefix STREQUAL prefix)
                        message(FATAL_ERROR "Extension FILES has case-colliding directories: ${prefix}")
                    endif()
                endif()
            endif()
        endforeach()
        get_filename_component(name "${relative}" NAME)
        string(REGEX MATCH "\\.[^.]+$" suffix "${name}")
        string(TOLOWER "${suffix}" suffix)
        if(NOT name STREQUAL "qmldir" AND NOT name STREQUAL "LICENSE" AND
           NOT name STREQUAL "NOTICE" AND NOT name STREQUAL "AUTHORS" AND
           NOT suffix MATCHES "^\\.(qml|js|mjs|json|svg|png|jpg|jpeg|webp|gif|ttf|otf|txt|md|qsb)$")
            message(FATAL_ERROR "Extension FILES contains a native/executable/unsupported file: ${relative}")
        endif()
        set(source "${source_root}/${relative}")
        if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
            message(FATAL_ERROR "Extension FILES must name an existing regular file: ${relative}")
        endif()
        get_filename_component(real_source "${source}" REALPATH)
        string(FIND "${real_source}" "${source_root}/" contained)
        if(NOT contained EQUAL 0)
            message(FATAL_ERROR "Extension FILES escapes its source directory: ${relative}")
        endif()
        file(SIZE "${source}" size)
        math(EXPR total "${total}+${size}")
        if(size GREATER 8388608 OR total GREATER 33554432)
            message(FATAL_ERROR "Extension runtime files exceed8MiB/file or32MiB/package")
        endif()
        list(APPEND seen "${folded}")
        list(APPEND absolute "${source}")
    endforeach()
    list(LENGTH directory_names directory_count)
    if(directory_count GREATER 63)
        message(FATAL_ERROR "Extension FILES exceeds64 directories including its root")
    endif()
    foreach(directory IN LISTS directory_names)
        if(directory IN_LIST seen)
            message(FATAL_ERROR "Extension FILES has a file/directory case collision: ${directory}")
        endif()
    endforeach()
    set(${absolute_files} "${absolute}" PARENT_SCOPE)
endfunction()

function(_rmext_read_manifest path files output)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Extension MANIFEST must name an existing regular JSON file")
    endif()
    file(SIZE "${path}" size)
    if(size GREATER 65536)
        message(FATAL_ERROR "Extension MANIFEST exceeds64KiB")
    endif()
    file(READ "${path}" manifest)
    string(JSON type ERROR_VARIABLE error TYPE "${manifest}")
    if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "OBJECT")
        message(FATAL_ERROR "Extension MANIFEST must be a JSON object: ${error}")
    endif()
    string(JSON native_type ERROR_VARIABLE native_error TYPE "${manifest}" native)
    if(native_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Input MANIFEST must omit native; use NATIVE_TARGET instead")
    endif()
    foreach(key IN ITEMS schema apiMajor)
        string(JSON type ERROR_VARIABLE error TYPE "${manifest}" "${key}")
        if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "NUMBER")
            message(FATAL_ERROR "Extension MANIFEST needs numeric ${key}:1")
        endif()
        string(JSON value GET "${manifest}" "${key}")
        if(NOT value EQUAL 1)
            message(FATAL_ERROR "Extension MANIFEST supports only ${key}:1")
        endif()
    endforeach()
    foreach(key IN ITEMS id version entry)
        string(JSON type ERROR_VARIABLE error TYPE "${manifest}" "${key}")
        if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "STRING")
            message(FATAL_ERROR "Extension MANIFEST needs string ${key}")
        endif()
        string(JSON ${key} GET "${manifest}" "${key}")
    endforeach()
    string(LENGTH "${id}" id_length)
    string(LENGTH "${version}" version_length)
    if(id_length GREATER 64 OR NOT id MATCHES "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$" OR
       id MATCHES "^(core|foundation)\\.")
        message(FATAL_ERROR "Extension MANIFEST has an invalid/reserved package id")
    endif()
    if(version_length GREATER 96 OR NOT version MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[A-Za-z0-9.-]+)?(\\+[A-Za-z0-9.-]+)?$")
        message(FATAL_ERROR "Extension MANIFEST needs a SemVer version")
    endif()
    string(LENGTH "${entry}" entry_length)
    if(entry_length GREATER 256 OR NOT entry MATCHES "\\.qml$" OR NOT entry IN_LIST files)
        message(FATAL_ERROR "Manifest entry must name a .qml file explicitly included in FILES")
    endif()
    foreach(key IN ITEMS services channels configuration)
        string(JSON type ERROR_VARIABLE error TYPE "${manifest}" "${key}")
        if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "OBJECT")
            message(FATAL_ERROR "Extension MANIFEST needs an object ${key}")
        endif()
    endforeach()
    foreach(group IN ITEMS services channels)
        if(group STREQUAL "services")
            set(keys exports required optional)
        else()
            set(keys publish subscribe)
        endif()
        foreach(key IN LISTS keys)
            string(JSON type ERROR_VARIABLE error TYPE "${manifest}" "${group}" "${key}")
            if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "ARRAY")
                message(FATAL_ERROR "Extension MANIFEST needs an array ${group}.${key}")
            endif()
        endforeach()
    endforeach()
    foreach(key IN ITEMS defaults schema)
        string(JSON type ERROR_VARIABLE error TYPE "${manifest}" configuration "${key}")
        if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "OBJECT")
            message(FATAL_ERROR "Extension MANIFEST needs configuration.${key} as an object")
        endif()
    endforeach()
    string(JSON type ERROR_VARIABLE error TYPE "${manifest}" panels)
    if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "ARRAY")
        message(FATAL_ERROR "Extension MANIFEST needs a panels array")
    endif()
    string(JSON count LENGTH "${manifest}" panels)
    if(count GREATER 16)
        message(FATAL_ERROR "Extension MANIFEST exceeds16 panels")
    endif()
    set(panel_ids)
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            foreach(key IN ITEMS id title entry)
                string(JSON type ERROR_VARIABLE error TYPE "${manifest}" panels ${index} "${key}")
                if(NOT error STREQUAL "NOTFOUND" OR NOT type STREQUAL "STRING")
                    message(FATAL_ERROR "Each extension panel needs string ${key}")
                endif()
                string(JSON panel_${key} GET "${manifest}" panels ${index} "${key}")
            endforeach()
            string(LENGTH "${panel_id}" panel_id_length)
            string(LENGTH "${panel_title}" panel_title_length)
            string(LENGTH "${panel_entry}" panel_entry_length)
            if(panel_id_length GREATER 64 OR NOT panel_id MATCHES "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$" OR
               panel_id IN_LIST panel_ids OR panel_title_length LESS 1 OR panel_title_length GREATER 128 OR
               panel_entry_length GREATER 256 OR NOT panel_entry MATCHES "\\.qml$" OR NOT panel_entry IN_LIST files)
                message(FATAL_ERROR "Invalid/duplicate panel or panel entry absent from explicit FILES")
            endif()
            list(APPEND panel_ids "${panel_id}")
        endforeach()
    endif()
    set(${output} "${manifest}" PARENT_SCOPE)
endfunction()

function(_robomaster_extension_package_assemble spec_path)
    file(READ "${spec_path}" spec)
    foreach(key IN ITEMS source_root package_root manifest target_system)
        string(JSON ${key} GET "${spec}" "${key}")
    endforeach()
    string(JSON count LENGTH "${spec}" files)
    set(files)
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON relative GET "${spec}" files ${index})
            list(APPEND files "${relative}")
        endforeach()
    endif()
    _rmext_validate_files("${source_root}" "${files}" "${_RMEXT_NATIVE}" absolute_files)
    _rmext_read_manifest("${manifest}" "${files}" manifest_json)
    set(configuration "${_RMEXT_CONFIG}")
    if(configuration STREQUAL "")
        set(configuration default)
    endif()
    if(NOT configuration MATCHES "^[A-Za-z0-9_][A-Za-z0-9_.+-]*$")
        message(FATAL_ERROR "Invalid extension build configuration name")
    endif()
    set(output "${package_root}/${configuration}/package")
    get_filename_component(package_parent "${package_root}" DIRECTORY)
    if(IS_SYMLINK "${package_parent}")
        message(FATAL_ERROR "Extension output parent cannot be a symlink")
    endif()
    if(_RMEXT_NATIVE)
        if(NOT EXISTS "${_RMEXT_NATIVE}" OR IS_DIRECTORY "${_RMEXT_NATIVE}" OR IS_SYMLINK "${_RMEXT_NATIVE}")
            message(FATAL_ERROR "NATIVE_TARGET did not produce a regular native library")
        endif()
        get_filename_component(native_name "${_RMEXT_NATIVE}" NAME)
        if(NOT native_name STREQUAL _RMEXT_NATIVE_NAME)
            message(FATAL_ERROR "NATIVE_TARGET output filename differs from TARGET_FILE_NAME")
        endif()
        foreach(forbidden IN ITEMS ";" ":" "\\" "\n" "\r" "\t")
            string(FIND "${native_name}" "${forbidden}" found)
            if(NOT found EQUAL -1)
                message(FATAL_ERROR "NATIVE_TARGET produced a nonportable filename")
            endif()
        endforeach()
        _rmext_json_string(native_json "native/${native_name}")
        string(JSON manifest_json SET "${manifest_json}" native "{\"library\":${native_json}}")
    endif()
    string(LENGTH "${manifest_json}" manifest_length)
    if(manifest_length GREATER 65536)
        message(FATAL_ERROR "Generated extension manifest exceeds64KiB")
    endif()
    set(total "${manifest_length}")
    set(artifact_files "${absolute_files}")
    if(_RMEXT_NATIVE)
        list(APPEND artifact_files "${_RMEXT_NATIVE}")
    endif()
    foreach(file IN LISTS artifact_files)
        file(SIZE "${file}" size)
        math(EXPR total "${total}+${size}")
        if(size GREATER 8388608 OR total GREATER 33554432)
            message(FATAL_ERROR "Generated extension exceeds8MiB/file or32MiB/package")
        endif()
    endforeach()
    # The marker sits outside the artifact; only a directory previously owned
    # by this exact invocation may be replaced. No source or sibling is swept.
    foreach(path IN ITEMS "${package_root}" "${package_root}/${configuration}" "${output}")
        if(IS_SYMLINK "${path}")
            message(FATAL_ERROR "Extension output cannot be a symlink: ${path}")
        endif()
    endforeach()
    set(marker "${package_root}/${configuration}/.robomaster-extension-owner")
    set(owner "RoboMasterExtensionPackage/v1\n${source_root}\n${package_root}\n")
    if(EXISTS "${marker}")
        if(IS_SYMLINK "${marker}")
            message(FATAL_ERROR "Extension ownership marker cannot be a symlink")
        endif()
        file(READ "${marker}" previous_owner LIMIT 8192)
        if(NOT previous_owner STREQUAL owner)
            message(FATAL_ERROR "Generated package directory belongs to another invocation; preserved")
        endif()
    elseif(EXISTS "${output}")
        message(FATAL_ERROR "Unowned existing package directory preserved: ${output}")
    endif()
    file(MAKE_DIRECTORY "${package_root}/${configuration}")
    file(WRITE "${marker}" "${owner}")
    file(REMOVE_RECURSE "${output}")
    file(MAKE_DIRECTORY "${output}")
    foreach(relative IN LISTS files)
        get_filename_component(parent "${output}/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        configure_file("${source_root}/${relative}" "${output}/${relative}" COPYONLY)
    endforeach()
    if(_RMEXT_NATIVE)
        file(MAKE_DIRECTORY "${output}/native")
        configure_file("${_RMEXT_NATIVE}" "${output}/native/${native_name}" COPYONLY)
        if(target_system STREQUAL "Linux")
            # Only the copied delivery ELF loses the author's build RPATH.
            # The host already supplies compatible SDK/Qt libraries; package
            # assembly must neither retain workstation paths nor edit the
            # original build target. Other platforms keep their native rules.
            file(RPATH_REMOVE FILE "${output}/native/${native_name}")
        endif()
    endif()
    file(WRITE "${output}/rmplugin.json" "${manifest_json}\n")
    message(STATUS "Extension package assembled: ${output}")
endfunction()

# robomaster_package_extension(NAME package_target MANIFEST rmplugin.json
#     [NATIVE_TARGET my_qt_plugin] FILES Main.qml Panel.qml [OUT_DIRECTORY var])
# OUT_DIRECTORY is a generator-expression path, isolated for each configuration.
function(robomaster_package_extension)
    if(CMAKE_VERSION VERSION_LESS 3.19)
        message(FATAL_ERROR "robomaster_package_extension requires CMake3.19 or newer")
    endif()
    cmake_parse_arguments(PARSE_ARGV 0 RMEXT "" "NAME;MANIFEST;NATIVE_TARGET;OUT_DIRECTORY" "FILES")
    if(RMEXT_UNPARSED_ARGUMENTS OR RMEXT_KEYWORDS_MISSING_VALUES OR NOT RMEXT_NAME OR NOT RMEXT_MANIFEST)
        message(FATAL_ERROR "Use NAME, MANIFEST, optional NATIVE_TARGET/OUT_DIRECTORY and explicit FILES")
    endif()
    if(NOT RMEXT_NAME MATCHES "^[A-Za-z0-9_][A-Za-z0-9_.+-]*$" OR
       RMEXT_NAME MATCHES "^(all|clean|help|test|install|package|package_source|edit_cache|rebuild_cache|ZERO_CHECK)$" OR
       TARGET "${RMEXT_NAME}")
        message(FATAL_ERROR "Invalid, reserved or existing extension build target: ${RMEXT_NAME}")
    endif()
    if(RMEXT_OUT_DIRECTORY AND NOT RMEXT_OUT_DIRECTORY MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "OUT_DIRECTORY must name a CMake output variable")
    endif()
    get_filename_component(source_root "${CMAKE_CURRENT_SOURCE_DIR}" REALPATH)
    get_filename_component(binary_root "${CMAKE_CURRENT_BINARY_DIR}" REALPATH)
    if(source_root STREQUAL binary_root)
        message(FATAL_ERROR "Extension packages require an out-of-source build")
    endif()
    set(native_target "")
    if(RMEXT_NATIVE_TARGET)
        if(NOT TARGET "${RMEXT_NATIVE_TARGET}")
            message(FATAL_ERROR "NATIVE_TARGET must already exist")
        endif()
        set(native_target "${RMEXT_NATIVE_TARGET}")
        get_target_property(aliased "${native_target}" ALIASED_TARGET)
        if(aliased)
            set(native_target "${aliased}")
        endif()
        get_target_property(imported "${native_target}" IMPORTED)
        get_target_property(type "${native_target}" TYPE)
        if(imported OR (NOT type STREQUAL "MODULE_LIBRARY" AND NOT type STREQUAL "SHARED_LIBRARY"))
            message(FATAL_ERROR "NATIVE_TARGET must be a nonimported MODULE/SHARED library")
        endif()
    endif()
    get_filename_component(manifest_path "${RMEXT_MANIFEST}" ABSOLUTE BASE_DIR "${source_root}")
    _rmext_validate_files("${source_root}" "${RMEXT_FILES}" "${native_target}" absolute_files)
    _rmext_read_manifest("${manifest_path}" "${RMEXT_FILES}" manifest_json)
    set(package_root "${binary_root}/rmplugin-packages/${RMEXT_NAME}")
    if(IS_SYMLINK "${binary_root}/rmplugin-packages" OR IS_SYMLINK "${package_root}")
        message(FATAL_ERROR "Extension generated directory cannot traverse a symlink")
    endif()
    _rmext_json_string(source_json "${source_root}")
    _rmext_json_string(package_json "${package_root}")
    _rmext_json_string(manifest_path_json "${manifest_path}")
    _rmext_json_string(system_json "${CMAKE_SYSTEM_NAME}")
    set(spec "{\"source_root\":${source_json},\"package_root\":${package_json},\"manifest\":${manifest_path_json},\"target_system\":${system_json},\"files\":[]}")
    set(index 0)
    foreach(relative IN LISTS RMEXT_FILES)
        _rmext_json_string(relative_json "${relative}")
        string(JSON spec SET "${spec}" files ${index} "${relative_json}")
        math(EXPR index "${index}+1")
    endforeach()
    file(MAKE_DIRECTORY "${package_root}")
    set(spec_path "${package_root}/assembly.json")
    set(driver_path "${package_root}/assemble.cmake")
    file(WRITE "${spec_path}" "${spec}\n")
    _rmext_bracket_quote(module_literal "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    _rmext_bracket_quote(spec_literal "${spec_path}")
    # Script mode starts with unset policies rather than the author's project
    # policy scope. Establish the same minimum before defining IN_LIST helpers.
    file(WRITE "${driver_path}" "cmake_minimum_required(VERSION 3.19)\ninclude(${module_literal})\n_robomaster_extension_package_assemble(${spec_literal})\n")
    set(native_argument "-D_RMEXT_NATIVE=")
    set(native_name_argument "-D_RMEXT_NATIVE_NAME=")
    set(dependencies "${manifest_path}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${spec_path}" "${driver_path}" ${absolute_files})
    if(native_target)
        set(native_argument "-D_RMEXT_NATIVE=$<TARGET_FILE:${native_target}>")
        set(native_name_argument "-D_RMEXT_NATIVE_NAME=$<TARGET_FILE_NAME:${native_target}>")
        list(APPEND dependencies "${native_target}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest_path}")
    add_custom_target("${RMEXT_NAME}"
        COMMAND "${CMAKE_COMMAND}" "-D_RMEXT_CONFIG=$<CONFIG>" "${native_argument}" "${native_name_argument}" -P "${driver_path}"
        DEPENDS ${dependencies}
        COMMENT "Assembling explicit RoboMaster extension ${RMEXT_NAME}"
        VERBATIM)
    if(RMEXT_OUT_DIRECTORY)
        set(${RMEXT_OUT_DIRECTORY} "${package_root}/$<IF:$<BOOL:$<CONFIG>>,$<CONFIG>,default>/package" PARENT_SCOPE)
    endif()
endfunction()
